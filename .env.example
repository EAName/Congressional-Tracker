# Copy to `.env` (gitignored) and fill in real values.

# Congress.gov API key (free from https://api.data.gov/signup/). Used by
# `vact ingest-bills` to populate dim_bill.policy_area / subjects, and
# `vact cosp fetch` for sponsorship/cosponsorship lists.
CONGRESS_API_KEY=your-key-here

# OpenFEC API key (same data.gov signup). Used by `vact fec snapshot` for
# dated campaign-finance snapshots under data/derived/fec_YYYYMMDD.json.
# DEMO_KEY works for smoke tests with strict rate limits.
FEC_API_KEY=your-key-here

# Optional overrides for the Stage-2 LLM classifier (see transforms/classify.py).
# VACT_LLM_API_KEY=
# VACT_LLM_MODEL=gpt-4o-mini
